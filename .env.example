# Copy to .env.local and fill in once the real values are confirmed.
# Leave a value empty to keep the on-site placeholder.

# Canonical origin used for metadata, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Contact — defaults are set in lib/site-config.ts; set these only to override.
# Never put placeholder or guessed addresses here.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TRADE_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Company details for the legal pages live in content/company.ts.

# Hero video is on by default; set to false to show the bottle photo hero instead.
NEXT_PUBLIC_HERO_VIDEO=
