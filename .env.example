# Copy to .env.local and fill in once the real values are confirmed.
# Leave a value empty to keep the on-site placeholder.

# Canonical origin used for metadata, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Contact — never put placeholder or guessed addresses here.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TRADE_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Legal pages (absolute or site-relative URLs).
NEXT_PUBLIC_LEGAL_PRIVACY_URL=
NEXT_PUBLIC_LEGAL_IMPRINT_URL=
NEXT_PUBLIC_LEGAL_TERMS_URL=

# Set to true after placing public/video/hero-desktop.mp4 and hero-mobile.mp4.
NEXT_PUBLIC_HERO_VIDEO=
